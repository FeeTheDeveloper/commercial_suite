# Copy to .env and fill in your keys. Never commit .env.

# LLM API used for script/copy generation (optional; offline fallback used if unset)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=https://api.openai.com/v1

# Text-to-speech provider (optional)
TTS_API_KEY=

# Generative image provider (optional)
IMAGE_API_KEY=
